Step 5: API: 1 Implementation

            @Service
            @RequiredArgsConstructor
            public class CustomerApiClient  implements ThirdPartyApiClient<CustomerApiResponse> {
            
                private final WebClient webClient;
            
                @Override
                public Mono<CustomerApiResponse> execute(Object request) {
            
                    CustomerApiRequest req =
                            (CustomerApiRequest) request;
            
                    return webClient.post()
                            .uri("https://api1.com/customer")
                            .bodyValue(req)
                            .retrieve()
                            .bodyToMono(CustomerApiResponse.class);
                }
            }


