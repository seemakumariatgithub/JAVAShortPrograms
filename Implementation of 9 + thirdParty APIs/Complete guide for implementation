Step 8: Aggregator Service


                  @Service
                  @RequiredArgsConstructor
                  public class AggregationService {
                  
                      private final CustomerApiClient customerApi;
                      private final LoanApiClient loanApi;
                  
                      public Mono<AggregatedResponse> aggregate(
                              AggregateRequest request) {
                  
                          Mono<CustomerApiResponse> customer = customerApi.execute(new CustomerApiRequest(request.customerId()));
                  
                          Mono<LoanApiResponse> loan = loanApi.execute(new LoanApiRequest(request.loanNumber()));
                  
                          return Mono.zip(customer, loan)
                                  .map(tuple -> {
                                          CustomerApiResponse c = tuple.getT1();
                                            LoanApiResponse l = tuple.getT2();
                  
                                      return AggregatedResponse.builder()
                                              .customerName(
                                                      c.getCustomerName())
                                              .loanAmount(
                                                      l.getAmount())
                                              .build();
                                  });
                      }
                  }

