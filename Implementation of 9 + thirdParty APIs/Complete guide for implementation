-  Registry :====

            @Service
            public class ApiRegistry {
            
                private final Map<String, ApiStrategy> map;
            
                public ApiRegistry(
                    List<ApiStrategy> strategies) {
            
                    map = strategies.stream()
                            .collect(Collectors.toMap(
                                ApiStrategy::getName,
                                Function.identity()));
                }
            }

