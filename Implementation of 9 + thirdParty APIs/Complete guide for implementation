Step 9: Circuit Breaker
                        Third-party APIs fail often.
                  
                  @CircuitBreaker(
                          name = "customer-api",
                          fallbackMethod = "fallback")
                  public Mono<CustomerApiResponse> execute(
                          Object request) {
                  
                  }

------ fallback method for customer

                  public Mono<CustomerApiResponse> fallback( Object request, Exception ex) {
                  
                      CustomerApiResponse response = new CustomerApiResponse();
                      response.setCustomerName("N/A");
                      return Mono.just(response);
                  }

